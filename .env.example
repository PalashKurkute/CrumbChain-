# ⚠️  DO NOT COMMIT THIS FILE WITH REAL VALUES!
# Copy this to .env and fill in your actual credentials

# MongoDB Configuration
MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/?appName=CrumbChain
DATABASE_NAME=crumbchain

# JWT Secret Key (generate a random secure string)
# Example: openssl rand -hex 32
JWT_SECRET_KEY=your-super-secret-jwt-key-here-change-this

# Server Configuration
PORT=5000

# File Upload Configuration
UPLOAD_FOLDER=uploads/id_proofs
MAX_FILE_SIZE=5242880

# Gemini API Configuration (Get from: https://makersuite.google.com/app/apikey)
GEMINI_API_KEY=your-gemini-api-key-here

# ============================================
# SETUP INSTRUCTIONS FOR YOUR TEAM:
# ============================================
# 1. Copy this file: cp .env.example .env
# 2. Fill in your actual credentials in .env
# 3. NEVER commit .env to git!
# 4. Keep .env local to your machine only
#
# To get MongoDB URI:
# - Go to MongoDB Atlas: https://cloud.mongodb.com
# - Create cluster or use existing
# - Click "Connect" → "Connect your application"
# - Copy the connection string
#
# To generate JWT secret:
# - Run: openssl rand -hex 32
# - Or use: https://randomkeygen.com/
#
# To get Gemini API key:
# - Go to: https://makersuite.google.com/app/apikey
# - Create new API key
# - Copy and paste here
